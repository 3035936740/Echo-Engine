# Build output is authoritative; convenience aliases may be in use by the editor.
if(NOT DEFINED SOURCE OR NOT DEFINED RUNTIME)
  message(FATAL_ERROR "deploy_runtime needs SOURCE and RUNTIME")
endif()
get_filename_component(runtime_dir "${RUNTIME}" DIRECTORY)
file(MAKE_DIRECTORY "${SOURCE}/bin")
function(deploy_executable destination required)
  if(EXISTS "${destination}")
    file(SHA256 "${RUNTIME}" source_hash)
    file(SHA256 "${destination}" destination_hash)
    if(source_hash STREQUAL destination_hash)
      return()
    endif()
  endif()
  string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
  set(staged "${destination}.${nonce}.tmp")
  file(COPY_FILE "${RUNTIME}" "${staged}" RESULT copied)
  if(copied STREQUAL "0")
    file(RENAME "${staged}" "${destination}" RESULT deployed)
  else()
    set(deployed "${copied}")
  endif()
  if(NOT deployed STREQUAL "0")
    file(REMOVE "${staged}")
    if(required)
      message(FATAL_ERROR "Cannot deploy required runtime ${destination}: ${deployed}")
    else()
      message(WARNING "Built runtime is available at ${RUNTIME}. Convenience entry was not replaced: ${destination} (${deployed}). Close applications using this entry and rebuild.")
    endif()
  endif()
endfunction()
# These files let either runtime filename launch directly from its build directory.
deploy_executable("${runtime_dir}/EchoEngine.exe" TRUE)
file(COPY_FILE "${SOURCE}/THIRD_PARTY_NOTICES.txt" "${runtime_dir}/THIRD_PARTY_NOTICES.txt" ONLY_IF_DIFFERENT)
file(COPY "${SOURCE}/projects/echo_of_kino/" DESTINATION "${runtime_dir}/project")
deploy_executable("${SOURCE}/bin/EchoOfKino.exe" FALSE)
deploy_executable("${SOURCE}/bin/EchoEngine.exe" FALSE)
file(COPY_FILE "${SOURCE}/THIRD_PARTY_NOTICES.txt" "${SOURCE}/bin/THIRD_PARTY_NOTICES.txt" ONLY_IF_DIFFERENT)
file(COPY "${SOURCE}/projects/echo_of_kino/" DESTINATION "${SOURCE}/bin/project")
