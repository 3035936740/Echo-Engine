string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
string(RANDOM LENGTH 8 nonce)
set(folder "${BINARY}/example-test-${stamp}-${nonce}")
file(MAKE_DIRECTORY "${folder}")
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result TIMEOUT 45 OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Example validation failed: ${result}\n${output}\n${error}")
  endif()
endfunction()
run("${BUILDER}" "${SOURCE}/projects/echo_of_kino" "${folder}/project")
run("${RUNTIME}" --project "${folder}/project" --diagnostics "${folder}/diagnostics" --smoke "${folder}/lab.ppm")
run("${RUNTIME}" --project "${folder}/project" --diagnostics "${folder}/diagnostics" --export-public "${folder}/public")
run("${RUNTIME}" --project "${folder}/project" --diagnostics "${folder}/diagnostics" --export-encrypted "${folder}/encrypted")
run("${folder}/public/EchoOfKino.exe" --diagnostics "${folder}/diagnostics" --smoke "${folder}/public.ppm")
run("${folder}/encrypted/EchoOfKino.exe" --diagnostics "${folder}/diagnostics" --smoke "${folder}/encrypted.ppm")
foreach(image lab public encrypted)
  file(SIZE "${folder}/${image}.ppm" size)
  if(size LESS 172800)
    message(FATAL_ERROR "Example capture missing / truncated: ${image}")
  endif()
endforeach()
file(WRITE "${folder}/verification.txt" "PASS example generator, full six-second oldest resume, native project launch, public/encrypted exports and native launch\n")
