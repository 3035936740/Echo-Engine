string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
string(RANDOM LENGTH 8 nonce)
set(folder "${BINARY}/desktop-test-${stamp}-${nonce}")
file(COPY "${SOURCE}/projects/echo_of_kino/" DESTINATION "${folder}/project")
execute_process(COMMAND "${RUNTIME}" --editor --project "${folder}/project" --verify "${folder}/images" RESULT_VARIABLE result TIMEOUT 45)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Desktop verification failed: ${result}")
endif()
message(STATUS "UI previews: ${folder}/images")
