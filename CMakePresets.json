{
  "version": 3,
  "configurePresets": [
    {
      "name": "gcc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {"CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++"},
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}
    },
    {"name": "gcc-debug", "inherits": "gcc-base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "gcc-release", "inherits": "gcc-base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}}
  ],
  "buildPresets": [
    {"name": "gcc-debug", "configurePreset": "gcc-debug"},
    {"name": "gcc-release", "configurePreset": "gcc-release"}
  ],
  "testPresets": [
    {"name": "gcc-debug", "configurePreset": "gcc-debug", "output": {"outputOnFailure": true}},
    {"name": "gcc-release", "configurePreset": "gcc-release", "output": {"outputOnFailure": true}}
  ]
}
