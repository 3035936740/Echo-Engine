# Echo Engine project format: all paths relative to this file
title=Echo of Kino
level=levels/start.echo
scripts=scripts/jump.lua;scripts/rewind.lua;scripts/hooks.lua;scripts/boss.lua
history_budget_mb=512
player_sprite=assets/assetKinoSheet.rgba
player_frame=56
player_width=224
player_height=224
player_offset_x=-100
player_offset_y=-136
player_idle=0,0,4,5
player_run=1,0,8,8
player_jump=0,4,1,1
player_fall=0,5,1,1
boss_sprite=assets/assetAster.rgba
boss_frame=48
boss_width=192
boss_height=192
boss_offset_x=-80
boss_offset_y=-112
boss_idle=1,0,4,4
boss_run=0,0,4,8
boss_jump=1,4,4,6
boss_fall=1,0,4,4
background_shader=shaders/environment.frag
environment=3
weather=0
weather_strength=0
wind=0.3
fog=0.04
fluid=0
raymarch=0
# Optional project music, PCM WAV / OGG Vorbis; loop points are project data, never engine literals.
music=audio/ambient.ogg
music_loop_start=2
music_loop_end=8

sunlight=1
fireflies=1
tile_sprite=assets/tiles.png
tile_frame=8

music_volume=0.5
se_volume=0.8
music_fade_in=1.0
se_1=audio/jump.wav
se_2=audio/hit.wav
se_3=audio/impact.wav

maps=levels/start.echo;levels/dawn.echo
music_loop=1
